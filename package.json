{
  "name": "hamava",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/timeline.test.ts tests/lyrics.test.ts tests/worker.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.jsonc *.html .github/workflows/*.yml",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "deploy:token": "bash scripts/deploy-with-token.sh",
    "setup:live": "bash scripts/setup-live.sh",
    "dev:worker": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.35.0"
  }
}
