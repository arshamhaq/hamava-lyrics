{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamava-lyrics",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "main": "worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
